{
  "name": "factory",
  "private": true,
  "description": "Factory source code and documentation scripts.",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "factory": "dist/src/cli/main.js"
  },
  "scripts": {
    "probe": "tsx src/probe/probe.ts",
    "preflight": "tsx src/preflight/models.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "npm run build -- --watch",
    "lint": "eslint src test scripts && knip",
    "test": "vitest run",
    "test:l3": "tsx scripts/run-layer.ts",
    "test:sample-gates": "tsx scripts/sample-gates.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:l3 && npm run build && npm run docs:build",
    "sandbox:pack": "tsx scripts/pack-todo-sandbox.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.7",
    "eslint": "9.39.5",
    "knip": "6.49.0",
    "mermaid": "11.17.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "6.4.6",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
